{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Recommendarr": {
    "Storage": {
      "DataDirectory": "config"
    },
    "Web": {
      "PublicUrl": ""
    },
    "History": {
      "Provider": "Tautulli"
    },
    "Sync": {
      "Interval": "06:00:00",
      "RunOnStartup": true
    },
    "Tautulli": {
      "BaseUrl": "",
      "ApiKey": ""
    },
    "Plex": {
      "BaseUrl": "",
      "Token": ""
    },
    "Tmdb": {
      "ApiKey": "",
      "Language": "en-US"
    },
    "Seerr": {
      "BaseUrl": "",
      "ApiKey": ""
    },
    "Embeddings": {
      "Provider": "Onnx",
      "Model": "bge-small-en-v1.5"
    },
    "Llm": {
      "Enabled": false
    },
    "Telegram": {
      "BotToken": ""
    },
    "Discord": {
      "BotToken": ""
    }
  }
}
