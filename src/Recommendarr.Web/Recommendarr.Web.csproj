<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Recommendarr.Core\Recommendarr.Core.csproj" />
    <ProjectReference Include="..\Recommendarr.Infrastructure\Recommendarr.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Recommendarr.Web.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Local runtime data (database, keys, downloaded models) is not part of the project; keeping it
         out of the item globs stops dotnet watch from reacting to every database write. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);config/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
