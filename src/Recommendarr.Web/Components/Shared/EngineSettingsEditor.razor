@using Recommendarr.Core.Recommendations

@* Edits a copy of the engine settings in place, for what-if evaluations and score breakdowns. *@
<div class="options-grid">
    <label>Similarity weight <input type="number" step="0.05" min="0" @bind="Value.SimilarityWeight" /></label>
    <label>Collaborative weight <input type="number" step="0.05" min="0" @bind="Value.CollaborativeWeight" /></label>
    <label>Quality weight <input type="number" step="0.05" min="0" @bind="Value.QualityWeight" /></label>
    <label>Recency half-life (days) <input type="number" step="15" min="1" @bind="Value.RecencyHalfLifeDays" /></label>
    <label>Min recency weight <input type="number" step="0.05" min="0" max="1" @bind="Value.MinRecencyWeight" /></label>
    <label>Rewatch bonus <input type="number" step="0.05" min="0" @bind="Value.RewatchBonus" /></label>
    <label>Liked title weight <input type="number" step="0.25" min="0" @bind="Value.LikedItemWeight" /></label>
    <label>Max taste clusters <input type="number" step="1" min="1" max="12" @bind="Value.TasteClusters" /></label>
    <label>Min cluster share <input type="number" step="0.01" min="0" max="1" @bind="Value.MinClusterShare" /></label>
    <label>TMDB "similar" link weight <input type="number" step="0.1" min="0" @bind="Value.SimilarLinkWeight" /></label>
    <label>Diversity λ (1 = none) <input type="number" step="0.05" min="0" max="1" @bind="Value.DiversityLambda" /></label>
    <label>Results per type <input type="number" step="5" min="1" @bind="Value.ResultsPerType" /></label>
    <label>Min TMDB votes <input type="number" step="10" min="0" @bind="Value.MinVoteCount" /></label>
    <label>Min TMDB rating <input type="number" step="0.5" min="0" max="10" @bind="Value.MinVoteAverage" /></label>
</div>

@code {
    [Parameter, EditorRequired] public RecommendationOptions Value { get; set; } = null!;
}
