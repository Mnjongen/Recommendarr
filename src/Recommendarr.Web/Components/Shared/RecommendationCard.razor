<article class="rec-card">
    <div class="poster">
        @if (Item.PosterUrl is not null)
        {
            <img src="@Item.PosterUrl" alt="" loading="lazy" />
        }
        else
        {
            <div class="poster-placeholder">@Item.Title</div>
        }
        @if (Badge is { } badge)
        {
            <span class="badge @badge.Css">@badge.Label</span>
        }
    </div>
    <div class="body">
        @* An inline @if would swallow the space before the year, so keep it an expression. *@
        <h3>@Item.Title <span class="year">@(Item.Year is null ? "" : $"({Item.Year})")</span></h3>
        <div class="meta">
            @* Invariant, like TMDB, so the rating doesn't depend on the server's locale. *@
            @if (Item.VoteAverage > 0) { <span>★ @Item.VoteAverage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span> }
            @foreach (var genre in Item.Genres.Take(2)) { <span>@genre</span> }
        </div>
        @if (Item.Reason is not null)
        {
            <p class="reason">@Item.Reason</p>
        }
        @if (Item.Overview is not null)
        {
            <p class="overview">@Item.Overview</p>
        }
        @if (Item.CanRequest && CanRequest)
        {
            <button class="button small request" disabled="@Busy" @onclick="OnRequest">@(Busy ? "Requesting…" : "Request")</button>
        }
        <div class="feedback-actions">
            <button class="button small feedback-like @(Item.Feedback == FeedbackKind.Like ? "selected" : "")"
                    aria-label="Like @Item.Title" aria-pressed="@(Item.Feedback == FeedbackKind.Like)"
                    disabled="@FeedbackBusy" @onclick="() => OnFeedback.InvokeAsync(FeedbackKind.Like)">
                @(Item.Feedback == FeedbackKind.Like ? "Liked" : "Like")
            </button>
            <button class="button small feedback-not-interested @(Item.Feedback == FeedbackKind.NotInterested ? "selected" : "")"
                    aria-label="Not interested in @Item.Title" aria-pressed="@(Item.Feedback == FeedbackKind.NotInterested)"
                    disabled="@FeedbackBusy" @onclick="() => OnFeedback.InvokeAsync(FeedbackKind.NotInterested)">
                Not interested
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public RecommendationView Item { get; set; } = null!;

    [Parameter] public bool Busy { get; set; }

    /// <summary>False when Seerr isn't configured.</summary>
    [Parameter] public bool CanRequest { get; set; } = true;

    [Parameter] public EventCallback OnRequest { get; set; }

    [Parameter] public bool FeedbackBusy { get; set; }

    [Parameter] public EventCallback<FeedbackKind> OnFeedback { get; set; }

    private (string Label, string Css)? Badge => Item.Availability switch
    {
        AvailabilityStatus.Available => ("On Plex", "available"),
        AvailabilityStatus.PartiallyAvailable => ("Partly on Plex", "available"),
        AvailabilityStatus.Processing => ("Requested", "requested"),
        AvailabilityStatus.Pending => ("Awaiting approval", "pending"),
        AvailabilityStatus.Blacklisted => ("Blocked", "blocked"),
        _ => null,
    };
}
