@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using Recommendarr.Infrastructure.Seerr
@inject IRecommendationsPageService Page

<PageTitle>Recommendations · Recommendarr</PageTitle>

<div class="page-header">
    <h1>@(_plexUserId == _ownId ? "Recommended for you" : $"Recommended for {UserName(_plexUserId)}")</h1>
    <div class="controls">
        @if (_profiles is not null)
        {
            <label>
                Viewing
                <select value="@_plexUserId" @onchange="ChangeUserAsync">
                    @foreach (var profile in _profiles)
                    {
                        <option value="@profile.PlexUserId">@profile.Username</option>
                    }
                </select>
            </label>
        }
        <div class="tabs" role="tablist">
            <button role="tab" class="@(_type == MediaType.Movie ? "active" : "")" @onclick="() => _type = MediaType.Movie">Movies (@Count(MediaType.Movie))</button>
            <button role="tab" class="@(_type == MediaType.Tv ? "active" : "")" @onclick="() => _type = MediaType.Tv">TV shows (@Count(MediaType.Tv))</button>
        </div>
    </div>
</div>

@if (_message is not null)
{
    <div class="toast @(_messageIsError ? "error" : "")" role="status" @onclick="() => _message = null">@_message</div>
}

@if (_items is null)
{
    <p class="muted">Loading…</p>
}
else if (_items.Count == 0)
{
    <div class="empty-state">
        <p>No recommendations yet. They appear after the next sync, once there's something in the watch history.</p>
    </div>
}
else
{
    <div class="grid">
        @foreach (var item in _items.Where(i => i.MediaType == _type))
        {
            <RecommendationCard @key="(item.MediaType, item.TmdbId)" Item="item" Busy="_busy.Contains(item.TmdbId)" CanRequest="Page.SeerrConfigured" OnRequest="() => RequestAsync(item)"
                                FeedbackBusy="_feedbackBusy.Contains(item.TmdbId)" OnFeedback="kind => FeedbackAsync(item, kind)" />
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private string _ownId = "";
    private string _plexUserId = "";
    private IReadOnlyList<ProfileSummary>? _profiles;
    private List<RecommendationView>? _items;
    private MediaType _type = MediaType.Movie;
    private readonly HashSet<int> _busy = [];
    private readonly HashSet<int> _feedbackBusy = [];
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _ownId = _plexUserId = user.PlexUserId() ?? "";

        // The admin can look at (and request for) every profile, which helps when tuning.
        if (user.IsAdmin())
            _profiles = await Page.GetProfilesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = (await Page.GetRecommendationsAsync(_plexUserId)).ToList();
        if (_items.Count > 0 && _items.All(i => i.MediaType != _type))
            _type = _items[0].MediaType;
    }

    private async Task ChangeUserAsync(ChangeEventArgs e)
    {
        var user = (await AuthState).User;
        if (e.Value is string id && user.CanActFor(id))
        {
            _plexUserId = id;
            _items = null;
            await LoadAsync();
        }
    }

    private async Task RequestAsync(RecommendationView item)
    {
        var user = (await AuthState).User;
        if (!user.CanActFor(_plexUserId) || !_busy.Add(item.TmdbId))
            return;
        try
        {
            var outcome = await Page.RequestAsync(_plexUserId, item.MediaType, item.TmdbId);
            if (outcome.Kind == RequestOutcomeKind.Created)
            {
                var index = _items!.IndexOf(item);
                _items[index] = item with { Availability = outcome.Availability ?? AvailabilityStatus.Pending };
                ShowMessage($"Requested {item.Title}.", error: false);
            }
            else
            {
                ShowMessage(outcome.Error ?? $"Couldn't request {item.Title}.", error: true);
            }
        }
        catch (Exception)
        {
            ShowMessage($"Couldn't reach Seerr to request {item.Title}. Try again later.", error: true);
        }
        finally
        {
            _busy.Remove(item.TmdbId);
        }
    }

    private async Task FeedbackAsync(RecommendationView item, FeedbackKind kind)
    {
        var user = (await AuthState).User;
        if (!user.CanActFor(_plexUserId) || !_feedbackBusy.Add(item.TmdbId))
            return;
        try
        {
            var outcome = await Page.RecordFeedbackAsync(_plexUserId, item.MediaType, item.TmdbId, kind);
            if (outcome != FeedbackOutcome.Saved)
            {
                ShowMessage("Couldn't save your feedback. Try again after the next sync.", error: true);
                return;
            }

            if (kind == FeedbackKind.NotInterested)
                _items!.Remove(item);
            else
            {
                var index = _items!.IndexOf(item);
                _items[index] = item with { Feedback = kind };
            }
            ShowMessage(kind == FeedbackKind.Like ? "Like saved. Recommendations update after the next sync." : "We'll show you fewer titles like this.", error: false);
        }
        catch (Exception)
        {
            ShowMessage("Couldn't save your feedback. Try again later.", error: true);
        }
        finally
        {
            _feedbackBusy.Remove(item.TmdbId);
        }
    }

    private void ShowMessage(string message, bool error) => (_message, _messageIsError) = (message, error);

    private int Count(MediaType type) => _items?.Count(i => i.MediaType == type) ?? 0;

    private string UserName(string id) => _profiles?.FirstOrDefault(p => p.PlexUserId == id)?.Username ?? id;
}
