@inherits LayoutComponentBase

<header class="topbar">
    <a class="brand" href="/">Recommendarr</a>
    <AuthorizeView>
        <Authorized>
            <nav>
                <NavLink href="/" Match="NavLinkMatch.All">Recommendations</NavLink>
                <NavLink href="/search">Search</NavLink>
                <NavLink href="/telegram">Telegram</NavLink>
                <AuthorizeView Policy="@AuthConstants.AdminPolicy" Context="admin">
                    <NavLink href="/admin">Admin</NavLink>
                </AuthorizeView>
            </nav>
            <div class="profile">
                @if (context.User.FindFirst(AuthConstants.ThumbClaim)?.Value is { } thumb)
                {
                    <img class="avatar" src="@thumb" alt="" />
                }
                <span>@context.User.Identity?.Name</span>
                <form method="post" action="/auth/switch">
                    <AntiforgeryToken />
                    <button type="submit" class="link">Switch profile</button>
                </form>
                <form method="post" action="/auth/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="link">Sign out</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
